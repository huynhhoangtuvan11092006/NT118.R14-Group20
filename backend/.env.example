# Development sample values only. Use strong unique credentials outside local development.
NODE_ENV=development
PORT=3000

# DATABASE_URL must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below.
DATABASE_URL="postgresql://bandup:local_dev_only_change_me@127.0.0.1:5432/bandup?schema=public"
POSTGRES_USER=bandup
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=bandup
POSTGRES_PORT=5432

# Optional; leave empty to disable CORS middleware (native Android doesn't need CORS).
CORS_ORIGIN=

# Required for authentication. Generate TWO independent secrets (>=32 chars each).
# Run: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_access_secret_in_local_env
JWT_REFRESH_SECRET=CHANGE_ME_generate_refresh_secret_in_local_env

# Real Email sending configuration (Optional - Uses Gmail SMTP by default)
# For Gmail: Use Google Account App Password (16 chars)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="IELTS Prep App <your_email@gmail.com>"

# Google Sign-In Web Client ID
GOOGLE_CLIENT_ID="196474169898-qfrti0ejk2e5fmkn5bkbjmbi3a3c0138.apps.googleusercontent.com"

# IELTS Writing AI evaluator
# Server-side only. Never commit the real API key.
GEMINI_API_KEY=CHANGE_ME_from_Google_AI_Studio

# Primary model
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback model
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Maximum Gemini evaluation timeout: 30 seconds
GEMINI_TIMEOUT_MS=30000


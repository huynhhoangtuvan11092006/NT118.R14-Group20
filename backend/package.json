{
  "name": "bandup-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "test:contracts": "node --test tests/contracts.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "db:verify": "node scripts/verify-db.mjs",
    "test:auth": "npm run build && node --test tests/auth.integration.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "zod": "4.1.12",
    "argon2": "0.45.1",
    "jsonwebtoken": "9.0.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "@types/jsonwebtoken": "9.0.10"
  }
}

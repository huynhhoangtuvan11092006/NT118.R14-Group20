{
  "info": {
    "name": "BandUp Auth API",
    "description": "Import and run sequentially. Change testEmail before registering. Only use demo credentials; collection variables hold tokens and should not be shared after testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "testEmail",
      "value": "bandup-demo-CHANGE-THIS@example.com"
    },
    {
      "key": "testPassword",
      "value": "TestOnlyPass#2026"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Register",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"fullName\": \"BandUp Tester\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status success\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const data = pm.response.json();",
              "if (data.accessToken) pm.collectionVariables.set(\"accessToken\", data.accessToken);",
              "if (data.refreshToken) pm.collectionVariables.set(\"refreshToken\", data.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status success\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const data = pm.response.json();",
              "if (data.accessToken) pm.collectionVariables.set(\"accessToken\", data.accessToken);",
              "if (data.refreshToken) pm.collectionVariables.set(\"refreshToken\", data.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Protected without token (expect 401)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"unauthorized\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Get profile (Bearer)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"my profile\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Update profile",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"BandUp Updated\",\n  \"dailyStudyMinutes\": 45,\n  \"expectedExamDate\": \"2027-05-01\"\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "06 Target Band",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/users/target-band",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "target-band"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetBand\": 7.5\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"band saved\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().user.targetBand).to.eql(7.5); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Refresh (rotate)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status success\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const data = pm.response.json();",
              "if (data.accessToken) pm.collectionVariables.set(\"accessToken\", data.accessToken);",
              "if (data.refreshToken) pm.collectionVariables.set(\"refreshToken\", data.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Logout (revoke refresh)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"logged out\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}

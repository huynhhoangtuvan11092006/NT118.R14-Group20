<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_test_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnZoomNotesT3P4"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_soft_indigo"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="PART 4 • QUESTIONS 31–40"
                android:textColor="@color/primary_blue"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Complete the notes below."
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Write ONE WORD ONLY for each answer."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="italic" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnZoomNotesT3P4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:text="View original 🔍"
            android:textColor="@color/primary_blue"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Notes Card Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_choice_unselected_soft"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Notes Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Space Traffic Management"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="#CBD5E1" />

        <!-- SECTION 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="A Space Traffic Management system"
            android:textColor="@color/primary_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="2dp"
            android:text="• is a concept similar to Air Traffic Control, but for satellites rather than planes."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Blank 31 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_choice_unselected_soft"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="• would aim to set up legal and [ 31 ] .................... ways of improving safety."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNotesBlank31"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_answer_listening"
                android:hint="Write answer for 31..."
                android:imeOptions="actionNext"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="• does not actually exist at present."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- SECTION 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="Problems in developing effective Space Traffic Management"
            android:textColor="@color/primary_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Blank 32 & 33 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_choice_unselected_soft"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="• Satellites are now quite [ 32 ] .................... and therefore more widespread (e.g. there are constellations made up of [ 33 ] .................... of satellites)."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNotesBlank32"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_answer_listening"
                android:hint="Write answer for 32..."
                android:imeOptions="actionNext"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNotesBlank33"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_answer_listening"
                android:hint="Write answer for 33..."
                android:imeOptions="actionNext"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Blank 34 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_choice_unselected_soft"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="• At present, satellites are not required to transmit information to help with their [ 34 ] .................... ."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNotesBlank34"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_answer_listening"
                android:hint="Write answer for 34..."
                android:imeOptions="actionNext"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Blank 35 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_choice_unselected_soft"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="• There are few systems for [ 35 ] .................... satellites."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNotesBlank35"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_answer_listening"
                android:hint="Write answer for 35..."
                android:imeOptions="actionNext"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bullet: Small pieces of debris -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:lineSpacingExtra="2dp"
            android:text="• Small pieces of debris may be difficult to identify."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Blank 36 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_choice_unselected_soft"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="• Operators may be unwilling to share details of satellites used for [ 36 ] .................... or commercial reasons."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNotesBlank36"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_answer_listening"
                android:hint="Write answer for 36..."
                android:imeOptions="actionNext"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Blank 37 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_choice_unselected_soft"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="• It may be hard to collect details of the object's [ 37 ] .................... at a given time."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNotesBlank37"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_answer_listening"
                android:hint="Write answer for 37..."
                android:imeOptions="actionNext"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Blank 38 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_choice_unselected_soft"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="• Scientists can only make a [ 38 ] .................... about where the satellite will go."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNotesBlank38"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_answer_listening"
                android:hint="Write answer for 38..."
                android:imeOptions="actionNext"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SECTION 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="Solutions"
            android:textColor="@color/primary_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="2dp"
            android:text="• Common standards should be agreed on for the presentation of information."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Blank 39 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_choice_unselected_soft"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="• The information should be combined in one [ 39 ] .................... ."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNotesBlank39"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_answer_listening"
                android:hint="Write answer for 39..."
                android:imeOptions="actionNext"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Blank 40 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_choice_unselected_soft"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="• A coordinated system must be designed to create [ 40 ] .................... in its users."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNotesBlank40"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_answer_listening"
                android:hint="Write answer for 40..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
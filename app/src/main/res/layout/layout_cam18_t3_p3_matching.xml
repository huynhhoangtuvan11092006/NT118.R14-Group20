            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView android:id="@+id/chip27_A" style="@style/MatchingChipStyle" android:text="A" />
            <TextView android:id="@+id/chip27_B" style="@style/MatchingChipStyle" android:text="B" />
            <TextView android:id="@+id/chip27_C" style="@style/MatchingChipStyle" android:text="C" />
            <TextView android:id="@+id/chip27_D" style="@style/MatchingChipStyle" android:text="D" />
            <TextView android:id="@+id/chip27_E" style="@style/MatchingChipStyle" android:text="E" />
            <TextView android:id="@+id/chip27_F" style="@style/MatchingChipStyle" android:text="F" />
            <TextView android:id="@+id/chip27_G" style="@style/MatchingChipStyle" android:text="G" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 28: Agricultural workers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_choice_unselected_soft"
        android:orientation="vertical"
        android:padding="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"

                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMatchingSelected26"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Not selected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layoutChips26"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView android:id="@+id/chip26_A" style="@style/MatchingChipStyle" android:text="A" />
            <TextView android:id="@+id/chip26_B" style="@style/MatchingChipStyle" android:text="B" />
            <TextView android:id="@+id/chip26_C" style="@style/MatchingChipStyle" android:text="C" />
            <TextView android:id="@+id/chip26_D" style="@style/MatchingChipStyle" android:text="D" />
            <TextView android:id="@+id/chip26_E" style="@style/MatchingChipStyle" android:text="E" />
            <TextView android:id="@+id/chip26_F" style="@style/MatchingChipStyle" android:text="F" />
            <TextView android:id="@+id/chip26_G" style="@style/MatchingChipStyle" android:text="G" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 27: Administrative staff -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_choice_unselected_soft"
        android:orientation="vertical"
        android:padding="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"

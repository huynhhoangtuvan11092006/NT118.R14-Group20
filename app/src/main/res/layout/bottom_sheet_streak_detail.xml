<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_streak"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <!-- 1. Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="#CBD5E1" />

    <!-- Header Row with Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/btnCloseStreakSheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_pill_soft_gray"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="#64748B" />
    </RelativeLayout>

    <!-- 2. Hero Streak Graphic -->
    <ImageView
        android:id="@+id/ivHeroFlame"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_streak_flame_mascot" />

    <!-- Streak Counter -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStreakBigNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="#0F172A"
            android:textSize="40sp"
            android:textStyle="bold"
            tools:text="7" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Ngày học liên tục"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_fire" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStreakEncouragement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Bạn đang có phong độ học tập tuyệt vời! Đừng để ngọn lửa lụi tàn nhé."
        android:textColor="#64748B"
        android:textSize="13sp" />

    <!-- 3. Weekly 7-Day Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card_weekly_calendar"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header of Weekly Box -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvWeeklyBoxTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-bold"
                android:text="TUẦN NÀY"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Daily Target Met Badge -->
            <TextView
                android:id="@+id/tvDailyGoalMetBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_pill_soft_emerald"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="✓ Đạt chỉ tiêu ngày"
                android:textColor="#059669"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- 7 Days Grid Container -->
        <LinearLayout
            android:id="@+id/layoutWeeklyDaysContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="7">

            <!-- Day Items will be inflated/bound dynamically -->
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Streak Freeze (Khiên bảo vệ chuỗi) Card -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_streak_freeze"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivFreezeShield"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_shield_freeze" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="80dp"
            android:layout_toEndOf="@id/ivFreezeShield"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Khiên bảo vệ chuỗi"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFreezeCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_soft_blue"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="1/2"
                    android:textColor="#0284C7"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tự động bảo lưu streak nếu bạn lỡ bận hoặc quên học 1 ngày."
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Toggle Switch Pill -->
        <LinearLayout
            android:id="@+id/btnToggleFreezePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_soft_blue"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_pill_soft_emerald" />

            <TextView
                android:id="@+id/tvFreezeStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã bật"
                android:textColor="#0284C7"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 5. Primary Action Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPracticeNowToKeepStreak"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_btn_primary_blue"
        android:fontFamily="sans-serif-bold"
        android:text="Luyện bài ngay để giữ chuỗi 🔥"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15.5sp" />

    <!-- 6. Secondary Dismiss Link -->
    <TextView
        android:id="@+id/btnDismissStreakSheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:padding="6dp"
        android:text="Để sau, quay lại bài học"
        android:textColor="#64748B"
        android:textSize="13.5sp" />

</LinearLayout>


<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#CBD5E1" />

    <!-- Icon Badge -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_circle_button">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_target"
            app:tint="@color/primary_blue" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvSubmitDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Nộp bài thi Reading?"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Bạn có chắc chắn muốn kết thúc và nộp bài thi\nngay bây giờ không?"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Circular Progress Indicator with Center Text -->
    <RelativeLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="16dp">

        <ProgressBar
            android:id="@+id/progressCircle"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:indeterminate="false"
            android:max="40"
            android:progress="35"
            android:progressDrawable="@drawable/bg_circular_progress" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCompletedRatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="35/40"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Câu hoàn thành"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 3 Stat Pills Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Pill Đã làm -->
        <TextView
            android:id="@+id/pillCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_soft_indigo"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="✓ Đã làm: 35"
            android:textColor="#2563EB"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Pill Cắm cờ -->
        <TextView
            android:id="@+id/pillFlagged"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_soft_orange"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="⚑ Cắm cờ: 2"
            android:textColor="#D97706"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Pill Chưa làm -->
        <TextView
            android:id="@+id/pillUnanswered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_purple_bg"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="! Chưa làm: 5"
            android:textColor="#DC2626"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Warning Card (if unattempted) -->
    <LinearLayout
        android:id="@+id/layoutWarningUnanswered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_warning_card_peach"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvWarningTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠ Bạn còn 5 câu chưa điền đáp án."
            android:textColor="#9A3412"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Các câu chưa điền sẽ tự động tính 0 điểm sau khi gửi nộp bài."
            android:textColor="#7C2D12"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Time Remaining Card -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_passages_box"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="⏳ Thời gian còn lại:"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvRemainingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="15 phút 32 giây"
            android:textColor="@color/primary_blue"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Action Buttons -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmSubmit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_primary_blue"
        android:text="➤  Xác nhận nộp bài"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinueExam"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_choice_selected"
        android:text="←  Tiếp tục làm bài"
        android:textAllCaps="false"
        android:textColor="@color/primary_blue"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>

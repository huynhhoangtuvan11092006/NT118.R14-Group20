<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_test_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnZoomMatchingT4P3"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_soft_indigo"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="PART 3 • QUESTIONS 23–27"
                android:textColor="@color/primary_blue"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Children doing origami"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Which comment do the students make about each of the following children in the video?\nChoose FIVE answers from the box and write the correct letter, A–G, next to Questions 23–27."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnZoomMatchingT4P3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:text="View original 🔍"
            android:textColor="@color/primary_blue"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Comments Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_choice_unselected_soft"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Comments"
            android:textColor="@color/primary_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:background="#CBD5E1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="A   demonstrated independence"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="B   asked for teacher support"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="C   developed a competitive attitude"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="D   seemed to find the activity calming"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="E   seemed pleased with the results"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="F   seemed confused"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="G   seemed to find the activity easy"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Children Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Children (Choose A–G):"
        android:textColor="@color/primary_blue"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Row 23: Sid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_choice_unselected_soft"
        android:orientation="vertical"
        android:padding="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="23. Sid"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMatchingSelected23"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Not selected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layoutChips23"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView android:id="@+id/chip23_A" style="@style/MatchingChipStyle" android:text="A" />
            <TextView android:id="@+id/chip23_B" style="@style/MatchingChipStyle" android:text="B" />
            <TextView android:id="@+id/chip23_C" style="@style/MatchingChipStyle" android:text="C" />
            <TextView android:id="@+id/chip23_D" style="@style/MatchingChipStyle" android:text="D" />
            <TextView android:id="@+id/chip23_E" style="@style/MatchingChipStyle" android:text="E" />
            <TextView android:id="@+id/chip23_F" style="@style/MatchingChipStyle" android:text="F" />
            <TextView android:id="@+id/chip23_G" style="@style/MatchingChipStyle" android:text="G" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 24: Jack -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_choice_unselected_soft"
        android:orientation="vertical"
        android:padding="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="24. Jack"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMatchingSelected24"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Not selected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layoutChips24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView android:id="@+id/chip24_A" style="@style/MatchingChipStyle" android:text="A" />
            <TextView android:id="@+id/chip24_B" style="@style/MatchingChipStyle" android:text="B" />
            <TextView android:id="@+id/chip24_C" style="@style/MatchingChipStyle" android:text="C" />
            <TextView android:id="@+id/chip24_D" style="@style/MatchingChipStyle" android:text="D" />
            <TextView android:id="@+id/chip24_E" style="@style/MatchingChipStyle" android:text="E" />
            <TextView android:id="@+id/chip24_F" style="@style/MatchingChipStyle" android:text="F" />
            <TextView android:id="@+id/chip24_G" style="@style/MatchingChipStyle" android:text="G" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 25: Naomi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_choice_unselected_soft"
        android:orientation="vertical"
        android:padding="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="25. Naomi"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMatchingSelected25"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Not selected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layoutChips25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView android:id="@+id/chip25_A" style="@style/MatchingChipStyle" android:text="A" />
            <TextView android:id="@+id/chip25_B" style="@style/MatchingChipStyle" android:text="B" />
            <TextView android:id="@+id/chip25_C" style="@style/MatchingChipStyle" android:text="C" />
            <TextView android:id="@+id/chip25_D" style="@style/MatchingChipStyle" android:text="D" />
            <TextView android:id="@+id/chip25_E" style="@style/MatchingChipStyle" android:text="E" />
            <TextView android:id="@+id/chip25_F" style="@style/MatchingChipStyle" android:text="F" />
            <TextView android:id="@+id/chip25_G" style="@style/MatchingChipStyle" android:text="G" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 26: Anya -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_choice_unselected_soft"
        android:orientation="vertical"
        android:padding="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="26. Anya"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMatchingSelected26"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Not selected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layoutChips26"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView android:id="@+id/chip26_A" style="@style/MatchingChipStyle" android:text="A" />
            <TextView android:id="@+id/chip26_B" style="@style/MatchingChipStyle" android:text="B" />
            <TextView android:id="@+id/chip26_C" style="@style/MatchingChipStyle" android:text="C" />
            <TextView android:id="@+id/chip26_D" style="@style/MatchingChipStyle" android:text="D" />
            <TextView android:id="@+id/chip26_E" style="@style/MatchingChipStyle" android:text="E" />
            <TextView android:id="@+id/chip26_F" style="@style/MatchingChipStyle" android:text="F" />
            <TextView android:id="@+id/chip26_G" style="@style/MatchingChipStyle" android:text="G" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 27: Zara -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_choice_unselected_soft"
        android:orientation="vertical"
        android:padding="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="27. Zara"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMatchingSelected27"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Not selected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layoutChips27"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView android:id="@+id/chip27_A" style="@style/MatchingChipStyle" android:text="A" />
            <TextView android:id="@+id/chip27_B" style="@style/MatchingChipStyle" android:text="B" />
            <TextView android:id="@+id/chip27_C" style="@style/MatchingChipStyle" android:text="C" />
            <TextView android:id="@+id/chip27_D" style="@style/MatchingChipStyle" android:text="D" />
            <TextView android:id="@+id/chip27_E" style="@style/MatchingChipStyle" android:text="E" />
            <TextView android:id="@+id/chip27_F" style="@style/MatchingChipStyle" android:text="F" />
            <TextView android:id="@+id/chip27_G" style="@style/MatchingChipStyle" android:text="G" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

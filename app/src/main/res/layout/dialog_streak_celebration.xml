<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_celebration"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Close Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnCloseCelebration"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_pill_soft_gray"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="#64748B" />
        </RelativeLayout>

        <!-- Animated Flame Mascot -->
        <ImageView
            android:id="@+id/ivCelebrationFlame"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/ic_streak_flame_mascot" />

        <!-- Title: CHUỖI X NGÀY! -->
        <TextView
            android:id="@+id/tvCelebrationTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:textColor="#0F172A"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="CHUỖI 6 NGÀY!" />

        <!-- Tagline Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_soft_orange"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_fire" />

            <TextView
                android:id="@+id/tvCelebrationBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="Ngọn lửa đang bùng cháy rực rỡ!"
                android:textColor="#C2410C"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Motivational Message -->
        <TextView
            android:id="@+id/tvCelebrationMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Bạn đã hoàn thành mục tiêu học tập hôm nay. Chỉ còn 1 ngày nữa để đạt mốc huy hiệu tuần!"
            android:textColor="#475569"
            android:textSize="13.5sp" />

        <!-- Reward Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_weekly_calendar"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp">

            <!-- Lightning / EXP Badge -->
            <TextView
                android:id="@+id/tvCelebrationExpReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="⚡ +50 EXP rèn luyện • Giữ mục tiêu Band 7.5+"
                android:textColor="#B45309"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CTA Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinueStreakCelebration"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_gradient_orange"
            android:fontFamily="sans-serif-bold"
            android:text="Tiếp tục phát huy ✨"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <!-- Share Link -->
        <TextView
            android:id="@+id/btnShareStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="6dp"
            android:text="🔗 Chia sẻ thành tích"
            android:textColor="#2563EB"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>

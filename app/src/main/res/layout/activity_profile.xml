<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hồ Sơ"
                android:textColor="#172033"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_recovery_icon"
                android:gravity="center"
                android:text="♙"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Thẻ thông tin tài khoản -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_profile_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_recovery_badge"
                android:gravity="center"
                android:text="👩🏻"
                android:textSize="35sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nguyễn Hải Yến"
                android:textColor="#172033"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="haiyen.nguyen@ielts-pro.vn"
                android:textColor="#68758A"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_recovery_badge"
                    android:padding="8dp"
                    android:text="✦  14 ngày"
                    android:textColor="#8A6500"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCurrentBand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_recovery_badge"
                    android:padding="8dp"
                    android:text="Band hiện tại: 6.5"
                    android:textColor="#154378"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mục tiêu học tập -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="◎  Mục tiêu học tập"
                android:textColor="#172033"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileTargetBand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_recovery_badge"
                android:padding="12dp"
                android:text="Band mục tiêu: 7.0 Overall"
                android:textColor="#154378"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileExamDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="10dp"
                android:text="Ngày thi dự kiến: Chưa chọn"
                android:textColor="#34445A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvProfileStudyTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="10dp"
                android:text="Mục tiêu học mỗi ngày: 30 phút/ngày"
                android:textColor="#34445A"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Thông tin cá nhân -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="♧  Thông tin cá nhân"
                android:textColor="#172033"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Họ và tên"
                android:textColor="#68758A"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/edtProfileName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_login_input"
                android:hint="Nhập họ và tên"
                android:inputType="textPersonName"
                android:padding="10dp"
                android:text="Nguyễn Hải Yến"
                android:textColor="#172033"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Địa chỉ Email"
                android:textColor="#68758A"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/edtProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_login_input"
                android:hint="Nhập email"
                android:inputType="textEmailAddress"
                android:padding="10dp"
                android:text="haiyen.nguyen@ielts-pro.vn"
                android:textColor="#172033"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Số điện thoại"
                android:textColor="#68758A"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/edtProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_login_input"
                android:hint="Nhập số điện thoại"
                android:inputType="phone"
                android:padding="10dp"
                android:text="0912 345 678"
                android:textColor="#172033"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Cài đặt và tiện ích -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☷  Cài đặt &amp; Tiện ích"
                android:textColor="#172033"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swNotifications"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Thông báo nhắc học"
                android:textColor="#34445A"
                android:textSize="13sp"
                android:checked="true" />

            <Switch
                android:id="@+id/swDarkMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Chế độ ban đêm"
                android:textColor="#34445A"
                android:textSize="13sp"
                android:checked="false" />

            <TextView
                android:id="@+id/btnLanguage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="◎  Ngôn ngữ giao diện: Tiếng Việt  ›"
                android:textColor="#34445A"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnMicrophone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="♬  Quyền micro và âm thanh  ›"
                android:textColor="#34445A"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="◎  Đổi mật khẩu  ›"
                android:textColor="#34445A"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_recovery_badge"
                android:gravity="center"
                android:text="⇥  Đăng xuất tài khoản"
                android:textColor="#A63838"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Lưu thay đổi -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#154378"
            android:text="✓  Lưu thay đổi"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>

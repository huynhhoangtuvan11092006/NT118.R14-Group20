<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FAF8FF">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#FAF8FF"
        android:elevation="2dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng"
            android:src="@drawable/ic_close"
            app:tint="#434655" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Vocabulary Session Results"
            android:textColor="#131B2E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circular_progress">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Tài khoản"
                android:src="@drawable/ic_person"
                app:tint="#FFFFFF" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Scrollable Body Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutStickyBottom"
        android:layout_below="@id/layoutTopBar"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Celebration Header Block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <!-- Glowing Trophy Badge -->
                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_trophy_outer" />

                    <View
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_trophy_inner" />

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="Trophy"
                        android:src="@drawable/ic_trophy"
                        app:tint="#F59E0B" />

                    <!-- Sparkle Badge -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:contentDescription="Star"
                        android:src="@drawable/ic_stars"
                        app:tint="#FBBF24" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvResultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Hoàn thành phiên học! 🎉"
                    android:textAlignment="center"
                    android:textColor="#131B2E"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResultSubtitle"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="Bạn đã củng cố trí nhớ cho 20 từ vựng chủ đề Environment."
                    android:textAlignment="center"
                    android:textColor="#64748B"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 3 Stat Metrics Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Metric 1: Total Studied -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vocab_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="4dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_vocab_icon_tile">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="Book"
                            android:src="@drawable/ic_menu_book"
                            app:tint="#434655" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvTotalStudied"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="20"
                        android:textColor="#131B2E"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Từ đã học"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <!-- Metric 2: Mastered Well -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vocab_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="4dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_tag_mastered">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="Check"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#16A34A" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvMasteredCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="16"
                        android:textColor="#16A34A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Ghi nhớ tốt"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <!-- Metric 3: XP Earned -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vocab_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="4dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_tag_review">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="XP"
                            android:src="@drawable/ic_fire"
                            app:tint="#EA580C" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvXpEarned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="+40 XP"
                        android:textColor="#B54E00"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Điểm KN"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- SRS Schedule Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_vocab_info_card"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Schedule"
                            android:src="@drawable/ic_schedule"
                            app:tint="#004AC6" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Lịch ôn tiếp theo"
                            android:textColor="#004AC6"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Status Chip -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_tag_mastered"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_dot_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Đúng tiến độ"
                            android:textColor="#166534"
                            android:textSize="11sp" />
                    </LinearLayout>
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvNextReviewSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="2dp"
                    android:text="8 từ sẽ đến hạn ôn lại vào ngày mai (theo chu kỳ SRS)."
                    android:textColor="#434655"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Reviewed Words Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="2dp">

                <TextView
                    android:id="@+id/tvReviewedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="Từ vựng vừa ôn tập (3/20)"
                    android:textColor="#131B2E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnToggleShowAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="sans-serif-medium"
                    android:padding="4dp"
                    android:text="Xem tất cả"
                    android:textColor="#004AC6"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Reviewed Words RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReviewedWords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_vocab_word_row" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Bottom Bar -->
    <LinearLayout
        android:id="@+id/layoutStickyBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FAF8FF"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Primary Button: Tiếp tục bài tiếp theo -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinueNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_primary_solid"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="Tiếp tục bài tiếp theo  ➔"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Ghost Button: Về trang từ vựng -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBackToHub"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_ghost_lavender"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="Về trang từ vựng"
            android:textAllCaps="false"
            android:textColor="#434655"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>


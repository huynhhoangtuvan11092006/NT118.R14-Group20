<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_screen">

    <!-- CỤM THƯƠNG HIỆU Ở CHÍNH GIỮA MÀN HÌNH -->
    <LinearLayout
        android:id="@+id/llCenterBranding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/llBottomSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.44">

        <!-- Squircle App Icon với Mũ Cử nhân & Tia sáng -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_splash_icon_box"
            android:elevation="10dp"
            android:outlineProvider="background">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_splash_logo" />
        </FrameLayout>

        <!-- Tiêu đề: IELTS + Badge Pro -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="IELTS"
                android:textColor="#0F172A"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_pro"
                android:fontFamily="sans-serif-black"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Pro"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Slogan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="280dp"
            android:text="Chinh phục Band điểm mục tiêu cùng AI Tutor"
            android:textColor="#475569"
            android:textSize="14.5sp" />

        <!-- Trust Badge: Chuẩn khảo thí Cambridge & IDP -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_pill_soft_blue"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_verified"
                app:tint="@color/primary_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Chuẩn khảo thí Cambridge &amp; IDP"
                android:textColor="#1E40AF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- CỤM LOADING & PHIÊN BẢN Ở DƯỚI CÙNG -->
    <LinearLayout
        android:id="@+id/llBottomSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Thanh loading mỏng bo góc 200dp -->
        <ProgressBar
            android:id="@+id/pbSplash"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="210dp"
            android:layout_height="5dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/bg_splash_progress" />

        <!-- Text trạng thái tải -->
        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Đang tải dữ liệu học tập •••"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Feature chips nhỏ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Band 7.0+   •   Adaptive AI   •   Live Mock Test"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- Phiên bản ứng dụng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Phiên bản 1.0.0 • Powered by Advanced AI"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Khai báo cho phép ứng dụng truy vấn dịch vụ TextToSpeech của Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.IELTs">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity
            android:name=".ui.practice.PracticeHubActivity"
            android:exported="true" />

        <activity
            android:name=".ui.reading.ReadingListActivity"
            android:exported="true" />

        <activity
            android:name=".ui.reading.ReadingPracticeActivity"
            android:exported="true" />

        <activity
            android:name=".ui.reading.ReadingResultActivity"
            android:exported="true" />

        <activity
            android:name=".ui.writing.WritingListActivity"
            android:exported="true" />

        <activity
            android:name=".ui.writing.WritingEditorActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.writing.WritingResultActivity"
            android:exported="true" />

        <activity
            android:name=".ui.listening.ListeningListActivity"
            android:exported="true" />

        <activity
            android:name=".ui.listening.ListeningPracticeActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true" />

        <activity
            android:name=".ui.listening.ListeningResultActivity"
            android:exported="true" />

        <activity
            android:name=".ui.auth.TargetBandActivity"
            android:exported="true" />

        <activity
            android:name=".ui.auth.ProfileActivity"
            android:exported="true" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="true" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.WelcomeActivity"
            android:exported="true" />

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.vocabulary.VocabularyHubActivity"
            android:exported="true" />

        <activity
            android:name=".ui.vocabulary.FlashcardActivity"
            android:exported="true" />

        <activity
            android:name=".ui.vocabulary.VocabularySessionResultActivity"
            android:exported="true" />

        <!-- Màn hình Cài đặt Nhắc nhở Học tập -->
        <activity
            android:name=".ui.reminder.StudyReminderActivity"
            android:exported="true" />

        <!-- Receiver nhận action từ Notification (ví dụ: Nhắc lại sau 15 phút) -->
        <receiver
            android:name=".ui.reminder.ReminderActionReceiver"
            android:exported="false" />

        <!-- Receiver tự động khôi phục lịch nhắc nhở sau khi máy khởi động lại -->
        <receiver
            android:name=".ui.reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
